# Copy to .env and replace values. Never commit real secrets.
POSTGRES_DB=bioinfobeats
POSTGRES_USER=bioinfobeats
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://bioinfobeats:change-this-local-password@db:5432/bioinfobeats
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
TAVILY_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_URL=http://localhost:3000
OAUTH_TOKEN_ENCRYPTION_KEY=use-a-long-random-secret-different-from-secret-key
RESEARCH_TIMEOUT_SECONDS=30
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional Replicate text-to-video model version hash. Input schema must accept prompt, duration and aspect_ratio.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL_VERSION=
MOTION_GENERATION_TIMEOUT_SECONDS=900
MOTION_POLL_INTERVAL_SECONDS=4
RENDER_TIMEOUT_SECONDS=180
MEDIA_STORAGE_DIR=/data/media
FFMPEG_BINARY=ffmpeg
BUFFER_ACCESS_TOKEN=
BUFFER_API_BASE_URL=https://api.buffer.com
